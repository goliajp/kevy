Mutant M1 / M1b: extra instructions per command.

After the command counter in start_command, a loop of KEVY_MUTANT_SPIN
iterations, two instructions each (dec, jnz, inline asm on x86_64 so the
count is exact). perfgate2 --mutant M1 sizes it per angle from the
reference's measured instructions:u per op: 3% for M1, 1.5% for M1b. The
report prints the shift the counters actually saw.

Must turn red: C.instr_u. M1b must not turn it red.

diff --git a/crates/kevy-rt/src/exec.rs b/crates/kevy-rt/src/exec.rs
index a1db3b381..45bede717 100644
--- a/crates/kevy-rt/src/exec.rs
+++ b/crates/kevy-rt/src/exec.rs
@@ -96,6 +96,7 @@ impl<C: Commands> Shard<C> {
         // One client command at the dispatch boundary (before fan-out, so a
         // multi-key command counts once) — INFO's total_commands_processed.
         self.commands.on_command();
+        mutant_spin();
         let ResolvedCmd { route, is_quit, is_write, block_hint, wake_idx, .. } = resolved;
         // Role-gated write rejection (read-only replica).
         // `seq` is already assigned by handle_command — resolve it
@@ -332,3 +333,26 @@ impl<C: Commands> Shard<C> {
     // [`crate::exec_fold`] — same `impl<C: Commands> Shard<C>`, split out
     // so this file stays under the 500-LOC house rule.
 }
+
+/// Mutant M1: a fixed number of extra user-space instructions per command,
+/// sized by the gate from the reference's measured instr/op. The loop is two
+/// instructions per iteration (dec, jnz) so the size is exact.
+#[inline(never)]
+fn mutant_spin() {
+    static SPIN: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    let n = *SPIN.get_or_init(|| {
+        std::env::var("KEVY_MUTANT_SPIN").ok().and_then(|v| v.parse().ok()).unwrap_or(0)
+    });
+    if n == 0 {
+        return;
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!("2:", "dec {n}", "jnz 2b", n = inout(reg) n => _,
+            options(nomem, nostack));
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    for i in 0..n {
+        std::hint::black_box(i);
+    }
+}
