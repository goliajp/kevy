+
+/// Mutant M3: one read per command from a 64 MiB table at a pseudo-random
+/// word, a last-level-cache miss for a handful of instructions. The table is
+/// written at creation so its pages are real memory, not the shared zero page.
+#[inline(never)]
+fn mutant_miss() {
+    const WORDS: usize = 8 << 20;
+    static TABLE: std::sync::OnceLock<Box<[u64]>> = std::sync::OnceLock::new();
+    std::thread_local!(static STATE: std::cell::Cell<u64> = const { std::cell::Cell::new(0x9e37_79b9_7f4a_7c15) });
+    let table = TABLE.get_or_init(|| (0..WORDS as u64).collect());
+    let i = STATE.with(|s| {
+        let v = s.get().wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+        s.set(v);
+        v
+    });
+    let word = &table[(i >> 40) as usize & (WORDS - 1)];
+    std::hint::black_box(unsafe { core::ptr::read_volatile(word) });
+}
