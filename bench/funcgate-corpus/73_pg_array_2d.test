# 2-dimensional arrays for INT / TEXT / BIGINT.
# PG external literal `{{...},{...}}` round-trips in both directions.

statement ok
CREATE TABLE grid (
    id INT NOT NULL,
    mi INT[][],
    mb BIGINT[][],
    mt TEXT[][]
)

statement ok
INSERT INTO grid VALUES
    (1, '{{1,2,3},{4,5,6}}', '{{9999999999}}', '{{a,b},{c,d}}'),
    (2, '{{NULL,2},{3,NULL}}', NULL, '{{x}}'),
    (3, '{}', '{}', '{}'),
    (4, NULL, NULL, NULL)

query T
SELECT mi::text FROM grid WHERE id = 1
----
{{1,2,3},{4,5,6}}

query T
SELECT mb::text FROM grid WHERE id = 1
----
{{9999999999}}

query T
SELECT mt::text FROM grid WHERE id = 1
----
{{a,b},{c,d}}

# NULL elements preserved.
query T
SELECT mi::text FROM grid WHERE id = 2
----
{{NULL,2},{3,NULL}}

# Empty 2D arrays.
query T
SELECT mi::text FROM grid WHERE id = 3
----
{}

# Full-row NULLs preserved.
query T
SELECT mb::text FROM grid WHERE id = 4
----
NULL

# Ragged literal → hard error.
statement error
INSERT INTO grid VALUES (99, '{{1,2},{3,4,5}}', NULL, NULL)
