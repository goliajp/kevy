# PG JSON builder family — to_json / to_jsonb, json_build_object,
# jsonb_build_object, json_build_array, jsonb_build_array,
# jsonb_set, jsonb_insert.
#
# Django JSONField Func wrappers, Rails Arel::Nodes::JsonBuildObject,
# SQLAlchemy func.json_build_object all compile down to these.

# ─── to_json / to_jsonb ──────────────────────────────────────────

query T
SELECT to_json(42)
----
42

query T
SELECT to_jsonb(9223372036854775807)
----
9223372036854775807

query T
SELECT to_json('hi'::text)
----
"hi"

query T
SELECT to_json(true)
----
true

query T
SELECT to_json(false)
----
false

# STRICT: a NULL argument gives a NULL result. This case used to assert the
# opposite, with the comment "NULL -> JSON literal 'null', NOT SQL NULL".
# Round 603 asked PG18 and it answers otherwise: to_json(NULL::int) IS NULL
# is true, and the UNTYPED spelling to_json(NULL) PG rejects outright
# ("could not determine polymorphic type"). The typed spelling is the one PG
# defines, so it is the one pinned here. A JSON null VALUE is a different
# thing -- see the pass-through case below -- and a NULL inside a builder is
# still the JSON null, which the json_build_object case pins.
query T
SELECT to_json(NULL::INT)
----
NULL

# Json input passes through verbatim.
query T
SELECT to_jsonb('{"a":1}'::json)
----
{"a": 1}

# ─── json_build_object / jsonb_build_object ──────────────────────

query T
SELECT json_build_object('a', 1, 'b', 'two', 'c', true)
----
{"a" : 1, "b" : "two", "c" : true}

query T
SELECT jsonb_build_object()
----
{}

query T
SELECT json_build_object('a', NULL, 'b', 1)
----
{"a" : null, "b" : 1}

# Odd-length arg list errors.
statement error
SELECT json_build_object('a', 1, 'b')

# NULL key errors.
statement error
SELECT json_build_object(NULL, 1)

# ─── json_build_array / jsonb_build_array ────────────────────────

query T
SELECT json_build_array(1, 'x', true, NULL)
----
[1, "x", true, null]

query T
SELECT jsonb_build_array()
----
[]

# ─── jsonb_set ───────────────────────────────────────────────────

query T
SELECT jsonb_set('{"a":1,"b":2}', '{a}', '99')
----
{"a": 99, "b": 2}

query T
SELECT jsonb_set('{"a":{"b":{"c":1}}}', '{a,b,c}', '"x"')
----
{"a": {"b": {"c": "x"}}}

query T
SELECT jsonb_set('[10,20,30]', '{1}', '99')
----
[10, 99, 30]

# Negative array index counts from end.
query T
SELECT jsonb_set('[10,20,30]', '{-1}', '99')
----
[10, 20, 99]

# Missing key with create_missing=true (default) → inserted.
query T
SELECT jsonb_set('{"a":1}', '{b}', '2')
----
{"a": 1, "b": 2}

# Missing key with create_missing=false → unchanged.
query T
SELECT jsonb_set('{"a":1}', '{b}', '2', false)
----
{"a": 1}

# ─── jsonb_insert ────────────────────────────────────────────────

# Default: insert BEFORE indexed element.
query T
SELECT jsonb_insert('[10,20,30]', '{1}', '99')
----
[10, 99, 20, 30]

# insert_after=true: insert AFTER indexed element.
query T
SELECT jsonb_insert('[10,20,30]', '{1}', '99', true)
----
[10, 20, 99, 30]

# Out-of-range positive index appends.
query T
SELECT jsonb_insert('[10,20]', '{99}', '"end"')
----
[10, 20, "end"]

# Object: creates new key.
query T
SELECT jsonb_insert('{"a":1}', '{b}', '"new"')
----
{"a": 1, "b": "new"}

# Object: replacing existing key errors (PG semantics).
statement error
SELECT jsonb_insert('{"a":1}', '{a}', '2')
