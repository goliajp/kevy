# PG range types — all 6 builtin variants share one Value::Range
# shape; the RangeKind tag pins element type for encode/decode.
# OIDs: int4range=3904, int8range=3926, numrange=3906,
# tsrange=3908, tstzrange=3910, daterange=3912.

statement ok
CREATE TABLE bookings (
    id INT NOT NULL,
    i4 INT4RANGE,
    i8 INT8RANGE,
    d DATERANGE,
    ts TSRANGE
)

statement ok
INSERT INTO bookings VALUES
    (1, '[1,10)', '[100,999)', '[2025-01-01,2025-12-31)', '[2025-06-01 09:00:00,2025-06-01 10:00:00)'),
    (2, '[1,10]', '[100,999]', '[2025-06-01,2025-06-30]', '[2025-06-01 09:00:00,2025-06-01 12:00:00]'),
    (3, '(,10)',  '(,999)',    '(,2025-12-31)',          '(,2025-06-01 10:00:00)'),
    (4, '[1,)',   '[100,)',    '[2025-01-01,)',          '[2025-06-01 09:00:00,)'),
    (5, 'empty',  'empty',     'empty',                  'empty'),
    (6, NULL,     NULL,        NULL,                     NULL)

# Half-open int range round-trip.
query T
SELECT i4 FROM bookings WHERE id = 1
----
[1,10)

# Closed int range.
query T
SELECT i4 FROM bookings WHERE id = 2
----
[1,11)

# Unbounded lower.
query T
SELECT i4 FROM bookings WHERE id = 3
----
(,10)

# Unbounded upper.
query T
SELECT i4 FROM bookings WHERE id = 4
----
[1,)

# 'empty' literal.
query T
SELECT i4 FROM bookings WHERE id = 5
----
empty

query T
SELECT i4 FROM bookings WHERE id = 6
----
NULL

# int8range round-trip.
query T
SELECT i8 FROM bookings WHERE id = 1
----
[100,999)

# daterange round-trip.
query T
SELECT d FROM bookings WHERE id = 1
----
[2025-01-01,2025-12-31)

# tsrange round-trip.
query T
SELECT ts FROM bookings WHERE id = 1
----
["2025-06-01 09:00:00","2025-06-01 10:00:00")

# Malformed range → hard error.
statement error
INSERT INTO bookings VALUES (99, '[1,)abc', NULL, NULL, NULL)
