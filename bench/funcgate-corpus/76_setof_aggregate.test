# v7.17.0 Phase 3.P0-48 — set-returning sources route through the
# aggregate executor.
#
# Phase 3.2 (`0ffd766`) wired `FROM generate_series(...)` and
# `FROM unnest(...)` as scan sources but the executor branched
# straight into per-row projection, never touching `aggregate::run`.
# So COUNT/SUM/MIN/MAX/string_agg over a set-returning source
# either errored at projection time or silently returned the wrong
# shape. P0-48 lands the aggregate dispatch on both paths.

# COUNT(*) over generate_series.
query I
SELECT COUNT(*) FROM generate_series(1, 100)
----
100

# SUM over generate_series.
query I
SELECT SUM(g) FROM generate_series(1, 10) AS g
----
55

# MIN / MAX over generate_series.
query II
SELECT MIN(g), MAX(g) FROM generate_series(5, 12) AS g
----
5
12

# Aggregate with WHERE filter.
query I
SELECT COUNT(*) FROM generate_series(1, 100) AS g WHERE g > 50
----
50

# GROUP BY on derived value from generate_series.
query II rowsort
SELECT mod(g, 2) AS parity, COUNT(*) FROM generate_series(1, 10) AS g GROUP BY mod(g, 2)
----
0
5
1
5

# COUNT(*) over unnest keeps duplicates.
query I
SELECT COUNT(*) FROM unnest(ARRAY['a','b','b','c','c','c']) AS u
----
6

# string_agg over unnest.
query T
SELECT string_agg(u, ',') FROM unnest(ARRAY['x','y','z']) AS u
----
x,y,z

# COUNT(*) over unnest with WHERE filter.
query I
SELECT COUNT(*) FROM unnest(ARRAY['a','b','b','c','c','c']) AS u WHERE u = 'c'
----
3

# Non-aggregate path (regression).
query I
SELECT g FROM generate_series(1, 3) AS g ORDER BY g DESC
----
3
2
1
