# DATE / TIMESTAMP types (v2.3). MySQL DATETIME aliases TIMESTAMP.

statement ok
CREATE TABLE events (id INT NOT NULL, day DATE, occurred_at TIMESTAMP)

# String literals coerce to DATE / TIMESTAMP on INSERT.
statement ok
INSERT INTO events VALUES (1, '2024-03-15', '2024-03-15 10:30:00')

statement ok
INSERT INTO events VALUES (2, '2024-01-01', '2024-01-01 00:00:00')

statement ok
INSERT INTO events VALUES (3, '2025-12-31', '2025-12-31 23:59:59.123456')

# Round-trip text rendering preserves the canonical form.
query T nosort
SELECT day FROM events ORDER BY day
----
2024-01-01
2024-03-15
2025-12-31

query T nosort
SELECT occurred_at FROM events ORDER BY occurred_at
----
2024-01-01 00:00:00
2024-03-15 10:30:00
2025-12-31 23:59:59.123456

# Comparison ordering matches calendar order.
query I nosort
SELECT id FROM events WHERE day >= '2024-03-15' ORDER BY id
----
1
3

# Cast Text → DATE works inline.
query T nosort
SELECT '2024-07-04'::DATE
----
2024-07-04

# Cast Text → TIMESTAMP, with fractional seconds.
query T nosort
SELECT '2024-07-04 12:34:56.789'::TIMESTAMP
----
2024-07-04 12:34:56.789

# Malformed DATE literal must fail.
statement error
INSERT INTO events VALUES (4, '2024-13-40', '2024-01-01 00:00:00')

# MySQL spelling DATETIME aliases TIMESTAMP at parse time.
statement ok
CREATE TABLE my_events (id INT NOT NULL, t DATETIME)

statement ok
INSERT INTO my_events VALUES (1, '2024-06-15 09:00:00')

query T nosort
SELECT t FROM my_events
----
2024-06-15 09:00:00
