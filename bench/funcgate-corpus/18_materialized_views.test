# v7.17.0 Phase 1.3 — CREATE MATERIALIZED VIEW + REFRESH +
# DROP MATERIALIZED VIEW. Pre-v7.17 CREATE MATERIALIZED VIEW
# parsed as Statement::Empty so the cache promise was a silent
# lie; SELECT FROM mv failed with table-not-found. v7.17 stores
# the materialised rows as a regular table plus a parallel
# `materialized_views` source registry the REFRESH path re-runs.

statement ok
CREATE TABLE t (id INT NOT NULL, v INT NOT NULL)

statement ok
INSERT INTO t VALUES (1, 100), (2, 200), (3, 300)

# ---- CREATE caches rows at create time ----

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT id, v FROM t WHERE v >= 200

query II rowsort
SELECT id, v FROM mv
----
2
200
3
300

# ---- mutate source, mv still shows the snapshot ----

statement ok
INSERT INTO t VALUES (4, 400)

query II rowsort
SELECT id, v FROM mv
----
2
200
3
300

# ---- REFRESH picks up the change ----

statement ok
REFRESH MATERIALIZED VIEW mv

query II rowsort
SELECT id, v FROM mv
----
2
200
3
300
4
400

# ---- REFRESH WITH NO DATA truncates ----

statement ok
REFRESH MATERIALIZED VIEW mv WITH NO DATA

query I
SELECT count(*) FROM mv
----
0

# REFRESH WITH DATA puts them back.
statement ok
REFRESH MATERIALIZED VIEW mv WITH DATA

query I
SELECT count(*) FROM mv
----
3

# ---- CREATE WITH NO DATA defers the materialisation ----

statement ok
CREATE MATERIALIZED VIEW mv2 AS SELECT id FROM t WITH NO DATA

query I
SELECT count(*) FROM mv2
----
0

statement ok
REFRESH MATERIALIZED VIEW mv2

query I
SELECT count(*) FROM mv2
----
4

# ---- CREATE with column-rename list ----

statement ok
CREATE MATERIALIZED VIEW mv3 (pk, value) AS SELECT id, v FROM t WHERE id = 1

query II
SELECT pk, value FROM mv3
----
1
100

# ---- IF NOT EXISTS keeps the original ----

statement ok
CREATE MATERIALIZED VIEW IF NOT EXISTS mv AS SELECT 999 AS id, 999 AS v FROM t

query I
SELECT count(*) FROM mv
----
3

# ---- collision with existing TABLE rejected ----

statement error
CREATE MATERIALIZED VIEW t AS SELECT id FROM t

# ---- DROP removes both backing table + source registry ----

statement ok
CREATE MATERIALIZED VIEW mv_drop AS SELECT id FROM t

statement ok
DROP MATERIALIZED VIEW mv_drop

statement error
SELECT id FROM mv_drop

statement error
REFRESH MATERIALIZED VIEW mv_drop

statement ok
DROP MATERIALIZED VIEW IF EXISTS does_not_exist

statement error
DROP MATERIALIZED VIEW does_not_exist
