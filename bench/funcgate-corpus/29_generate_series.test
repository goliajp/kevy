# v7.17.0 Phase 3.10 — `FROM generate_series(start, stop [, step])`
# set-returning source. Integer + (TIMESTAMP, TIMESTAMP, INTERVAL).

# Integer two-arg form (default step = 1).
query I
SELECT * FROM generate_series(1, 5)
----
1
2
3
4
5

# Three-arg form with explicit step.
query I
SELECT * FROM generate_series(1, 10, 2)
----
1
3
5
7
9

# Descending range with negative step.
query I
SELECT * FROM generate_series(5, 1, -1)
----
5
4
3
2
1

# Empty range (start > stop, positive step).
query I
SELECT * FROM generate_series(10, 5)
----

# Aliased + WHERE in same SELECT.
query I
SELECT s FROM generate_series(1, 10) AS s WHERE s > 7 ORDER BY s
----
8
9
10

# Cross with regular table via subquery.
statement ok
CREATE TABLE t (id INT NOT NULL)

statement ok
INSERT INTO t VALUES (1), (2), (3)

query I rowsort
SELECT id FROM t WHERE id IN (SELECT * FROM generate_series(1, 2))
----
1
2

# Timestamp + 1 day interval — endpoints inclusive.
query T
SELECT * FROM generate_series('2024-01-01 00:00:00'::TIMESTAMP, '2024-01-04 00:00:00'::TIMESTAMP, '1 day'::INTERVAL)
----
2024-01-01 00:00:00
2024-01-02 00:00:00
2024-01-03 00:00:00
2024-01-04 00:00:00

# Hour-stepped iteration — 00:00, 01:00, 02:00, 03:00.
query T
SELECT * FROM generate_series('2024-01-01 00:00:00'::TIMESTAMP, '2024-01-01 03:00:00'::TIMESTAMP, '1 hour'::INTERVAL)
----
2024-01-01 00:00:00
2024-01-01 01:00:00
2024-01-01 02:00:00
2024-01-01 03:00:00
