# PG-style CREATE TABLE variations

statement ok
CREATE TABLE a (id INT)

statement ok
CREATE TABLE b (id INT NOT NULL, name TEXT NOT NULL)

statement ok
CREATE TABLE c (id BIGINT NOT NULL, ratio FLOAT, ok BOOL)

# v7.39 (round 621) — a table with NO columns is legal, and this case used to
# assert the opposite. Measured against live PG18: it creates the table, and
# `INSERT ... DEFAULT VALUES` puts a row in it. The expectation here was SPG's
# own refusal written down as if it were the rule.
statement ok
CREATE TABLE empty ()

statement ok
INSERT INTO empty DEFAULT VALUES

query I
SELECT count(*) FROM empty
----
1

# Duplicate table name is a runtime error.
statement ok
CREATE TABLE dup (id INT)

statement error
CREATE TABLE dup (id INT)
