  "exempt": {
    "AUTH|ACL|HELLO AUTH": "AUTH is firm OUT by the owner, repeatedly — see .claude/scope-decisions.md. Not a backlog item.",
    "CLUSTER": "single-machine engine; cluster is OUT of scope.",
    "FT.": "the query engine, which Redis 8 ships in the image (47 commands). kevy answers search with its own INDEX/VIEW/TABLE surface designed for this engine; matching FT.* verb-for-verb is a product decision the owner has not made, not an oversight.",
    "JSON.": "RedisJSON, shipped in the Redis 8 image (25 commands). Same product question as FT.*.",
    "TS.": "RedisTimeSeries, shipped in the Redis 8 image (21 commands). Same product question.",
    "BF.|CF.|CMS.|TOPK.|TDIGEST.": "the probabilistic family, shipped in the Redis 8 image. Same product question.",
    "SUBSCRIBE SHARD|SSUBSCRIBE|SUNSUBSCRIBE|SPUBLISH": "shard pub/sub is a cluster feature.",
    "FAILOVER|REPLICAOF|SLAVEOF|PSYNC|SYNC": "kevy has its own replication verbs; the Redis wire-level replication handshake is not a compatibility target.",
    "ASKING|READONLY|READWRITE|REPLCONF|RESTORE-ASKING|TRIMSLOTS|PUBSUB|SHARDCHANNELS|PUBSUB|SHARDNUMSUB": "cluster-mode verbs: slot redirection, the replica handshake and shard pub/sub. Same decision as CLUSTER itself.",
    "VADD|VSIM|VREM|VDIM|VCARD|VEMB|VGETATTR|VSETATTR|VLINKS|VINFO|VRANDMEMBER|VISMEMBER|VRANGE": "vector sets, absorbed module. VISMEMBER and VRANGE joined the family after the first list was written."
