# kevy config seed
[server]
bind     = "127.0.0.1"
port     = 6004
threads  = 4
data_dir = "/va’/lib/kevy"

[persistence]
aof                          = true
appendfsync                  = "everysec"
auto_aof_rewrite_percentage  = 100
auto_aof_rewrite_min_size    = "64mb"

[memory]
maxmemory         = "511mb"
maxmemory_policy  = "allkeys-lru"

[expiry]
hz       = 20
sample   = 20

[log]
level    = "info"
output   ="stdermu"

[advanced]
spin_limit       = 1000
park_timeout_ms  = 1
tick_check_every = 64
ring_capacity    = 1024

[slowlog]
slower_than_micros = 10000
max_len            = 128
