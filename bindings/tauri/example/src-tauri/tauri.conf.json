{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kevy-tauri-example",
  "version": "0.1.0",
  "identifier": "jp.golia.kevy.example",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "kevy + Tauri",
        "width": 860,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
