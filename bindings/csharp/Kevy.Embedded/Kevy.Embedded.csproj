<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kevy.Embedded — kevy embedded for .NET, P/Invoke over the kevy-ffi
       C ABI. The published NuGet ships the engine cdylib under
       runtimes/<rid>/native/ (copied in at pack time — the .gitignore'd
       runtimes/ tree); development and ffigate point KEVY_FFI_LIB straight
       at target/debug instead. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Kevy.Embedded</RootNamespace>

    <!-- The unified `kevy` NuGet package is now produced by Kevy.Client,
         which folds this FFI door in as an internal building block. This
         project is compiled + referenced but no longer packed on its own
         (avoids a duplicate `kevy` package id). Packaging policy pending
         user confirmation — see the v4-csharp-client report. -->
    <IsPackable>false</IsPackable>
    <PackageId>Kevy.Embedded.Internal</PackageId>
    <Version>5.4.1</Version>
    <Authors>GOLIA K.K.</Authors>
    <Description>kevy embedded in .NET — the real native engine behind one Cmd() entry plus a typed surface. TTL, structures, pub/sub, persistence you can read; pure Rust, zero services.</Description>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/goliajp/kevy</RepositoryUrl>
    <PackageProjectUrl>https://kevy.golia.jp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes/" Condition="Exists('runtimes')" />
  </ItemGroup>

</Project>
