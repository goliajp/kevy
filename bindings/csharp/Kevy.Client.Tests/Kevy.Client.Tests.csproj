<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contract-conformance tests (contract §6). Each behaviour is asserted
       on BOTH backends: embedded (mem://) and a real remote server spawned
       per session (kevy://127.0.0.1:PORT), except the remote-only families. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kevy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kevy.Client/Kevy.Client.csproj" />
    <!-- Direct, because Kevy.Client marks its own reference to this
         PrivateAssets="all" — it folds the assembly into the package
         rather than exposing it as a dependency, and that hides it from
         anything reaching it transitively. The tests exercise the
         embedded surface by name, so they ask for it themselves. -->
    <ProjectReference Include="../Kevy.Embedded/Kevy.Embedded.csproj" />
  </ItemGroup>

</Project>
