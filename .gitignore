/target
# Nested target/ dirs (e.g. each fuzz/ has its own cargo workspace + target).
**/target/
**/*.rs.bk
# cargo-fuzz default artifact dirs (corpus shared across runs, harness output).
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
# kevy persistence artifacts (snapshots + append-only logs)
dump-*.rdb
aof-*.aof
shards.meta
feed-*.gen
feed-*.meta
index-catalog.meta
.premigration/

# Claude Code workspace — kept entirely local, not part of the public repo.
.claude/

# Node ecosystem pollution — kevy has no Node.js dependencies in
# this repo. Any node_modules/ + package*.json here come from
# ad-hoc ecosystem-compat tests that should never have been
# `git add`-ed (caused the v1.27.7 4024-file disaster). Belt-and-
# braces with `.npmrc prefix=` too if a future test needs npm in
# this tree.
node_modules/
**/node_modules/
package.json
package-lock.json
# …except the website's. It is a real source tree, not an installed
# artefact: `npm ci` needs its lockfile to be reproducible, CI's node
# cache keys on it, and without package.json the site job cannot start at
# all. The rules above are for the language bindings, whose manifests and
# lockfiles belong to whoever installs them.
!web/package.json
!web/package-lock.json
yarn.lock
bun.lock
# …but the packages we SHIP are real: their manifests are exempt
# (bindings/expo/package.json was silently swallowed by the rule
# above once — the npm package landed on origin with no manifest).
!bindings/**/package.json
!packaging/npm/**/package.json
!crates/kevy-wasm/pkg/package.json
pnpm-lock.yaml

# Python virtualenvs — same reasoning as node_modules.
.venv/
**/.venv/
__pycache__/
**/__pycache__/

# Ruby Bundler — same reasoning.
vendor/bundle/
**/vendor/bundle/
.bundle/
view-catalog.meta
index-catalog.meta
bench/iot-consumer/target/
bench/mcu-probe/target/
bench/iot-consumer/riscv-out

# perfgate builds the reference binary from the baseline commit and caches it here.
bench/.perfgate-ref/
# capacity-envelope.sh writes its per-run verdicts here (tiergate consumes them).
bench/.capacity-envelope-results
aof-*.aof.premigration.*
dump-*.rdb.premigration.*
tools/facadegate/target/
/tier/
bench/.flake-archive/*.log

# SwiftPM build output — the root Package.swift puts it here.
.build/

# Release credentials kept beside the repo that uses them: the Maven
# Central Portal token, and the signing key whose public half Central
# already trusts. Never tracked — this line exists before the directory
# does, so there is no window in which a private key sits in git's
# working tree unignored.
.secrets/
